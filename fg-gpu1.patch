diff --git a/include/PCH.h b/include/PCH.h
index 149af74..a90fe1e 100644
--- a/include/PCH.h
+++ b/include/PCH.h
@@ -15,7 +15,9 @@
 #undef DEBUG
 #undef ERROR
 
+#include <cstdint>
 #include <string>
+#include <typeinfo>
 using namespace std::literals;
 
 #include "detours/detours.h"
@@ -63,16 +65,51 @@ namespace stl
 		T::func = vtbl.write_vfunc(idx, T::thunk);
 	}
 
+	namespace detail
+	{
+		// MGPU Scaling: where a function's entry jumps when another plugin hooked it first, or 0.
+		// Microsoft Detours (Community Shaders' frame annotations) and CommonLib's 5-byte branches
+		// write "jmp rel32"; 6-byte branches write "jmp [rip+disp32]".
+		inline std::uintptr_t HookedEntryTarget(std::uintptr_t a_entry) noexcept
+		{
+			const auto* code = reinterpret_cast<const std::uint8_t*>(a_entry);
+			if (code[0] == 0xE9)
+				return a_entry + 5 + static_cast<std::intptr_t>(*reinterpret_cast<const std::int32_t*>(code + 1));
+			if (code[0] == 0xFF && code[1] == 0x25) {
+				const auto slot = a_entry + 6 + static_cast<std::intptr_t>(*reinterpret_cast<const std::int32_t*>(code + 2));
+				return *reinterpret_cast<const std::uintptr_t*>(slot);
+			}
+			return 0;
+		}
+
+		// Nukem's DetourFunction copies the entry's first instructions into its trampoline without
+		// fixing relative ones. On a function another plugin hooked first, that copied jump lands on
+		// garbage and the game crashes on the first call (Community Shaders with frame annotations:
+		// DrawWorld::Forward and DrawWorld::Imagespace, on the first world frame). Chain behind the
+		// other hook instead: the entry jumps here, and the original is where its jump went, which
+		// runs the other hook and then the game's function. Returns the original.
+		inline std::uintptr_t DetourOrChain(std::uintptr_t a_target, std::uintptr_t a_thunk, const char* a_name)
+		{
+			if (const auto previous = HookedEntryTarget(a_target)) {
+				REL::GetTrampoline().write_jmp<5>(a_target, a_thunk);
+				REX::INFO("[HOOK] {} at {:#x} was already hooked by another plugin (jump to {:#x}); chained behind it",
+					a_name, a_target, previous);
+				return previous;
+			}
+			return Detours::X64::DetourFunction(a_target, a_thunk);
+		}
+	}
+
 	template <class T>
 	void detour_thunk(REL::ID a_relId)
 	{
-		*(uintptr_t*)&T::func = Detours::X64::DetourFunction(a_relId.address(), (uintptr_t)&T::thunk);
+		*(uintptr_t*)&T::func = detail::DetourOrChain(a_relId.address(), (uintptr_t)&T::thunk, typeid(T).name());
 	}
 
 	template <class T>
 	void detour_thunk_ignore_func(REL::ID a_relId)
 	{
-		std::ignore = Detours::X64::DetourFunction(a_relId.address(), (uintptr_t)&T::thunk);
+		std::ignore = detail::DetourOrChain(a_relId.address(), (uintptr_t)&T::thunk, typeid(T).name());
 	}
 
 	template <std::size_t idx, class T>
diff --git a/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl b/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl
new file mode 100644
index 0000000..281acb9
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl
@@ -0,0 +1,51 @@
+// FG-GPU1 (iHalfResDepthMV = 1): runs on the frame-generation GPU. Rebuilds full-resolution
+// depth from the half-resolution depth that crossed PCIe, so FSR3 still works at full
+// resolution and reads every motion vector; only its depth tests see the coarser depth.
+//
+// Smooth surfaces (floors, walls) are interpolated bilinearly. Where the four neighbouring
+// samples differ a lot - an object edge - blending would invent a depth that belongs to neither
+// surface and FSR3 would see a false edge or disocclusion there, so the pixel takes the sample
+// of its own 2x2 block instead (which already holds that block's nearest depth).
+
+Texture2D<float> HalfDepth : register(t0);
+RWTexture2D<float> FullDepth : register(u0);
+
+// FO4 depth runs 0 (near) .. 1 (far) and 1 - depth is close to proportional to 1/distance.
+// Neighbours whose 1/distance differs by more than this fraction count as an edge.
+static const float kEdgeThreshold = 0.05;
+
+[numthreads(8, 8, 1)] void main(uint3 DTid : SV_DispatchThreadID)
+{
+	uint fullWidth, fullHeight, halfWidth, halfHeight;
+	FullDepth.GetDimensions(fullWidth, fullHeight);
+	HalfDepth.GetDimensions(halfWidth, halfHeight);
+	if (DTid.x >= fullWidth || DTid.y >= fullHeight)
+		return;
+
+	const int2 last = int2(halfWidth - 1, halfHeight - 1);
+
+	// Position in half-resolution texels: full pixel 2i sits at i - 0.25, 2i + 1 at i + 0.25.
+	const float2 position = (float2(DTid.xy) + 0.5) * 0.5 - 0.5;
+	const int2 base = int2(floor(position));
+	const float2 weight = position - float2(base);
+
+	const float d00 = HalfDepth[clamp(base, int2(0, 0), last)];
+	const float d10 = HalfDepth[clamp(base + int2(1, 0), int2(0, 0), last)];
+	const float d01 = HalfDepth[clamp(base + int2(0, 1), int2(0, 0), last)];
+	const float d11 = HalfDepth[clamp(base + int2(1, 1), int2(0, 0), last)];
+
+	const float w00 = 1.0 - d00;
+	const float w10 = 1.0 - d10;
+	const float w01 = 1.0 - d01;
+	const float w11 = 1.0 - d11;
+	const float nearest = max(max(w00, w10), max(w01, w11));
+	const float farthest = min(min(w00, w10), min(w01, w11));
+
+	float depth;
+	if (nearest <= farthest * (1.0 + kEdgeThreshold))
+		depth = lerp(lerp(d00, d10, weight.x), lerp(d01, d11, weight.x), weight.y);
+	else
+		depth = HalfDepth[min(DTid.xy / 2, uint2(last))];
+
+	FullDepth[DTid.xy] = depth;
+}
diff --git a/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl b/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl
new file mode 100644
index 0000000..9533257
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl
@@ -0,0 +1,72 @@
+// FG-GPU1 (iHalfResDepthMV = 1 or 2): writes the depth that crosses PCIe at half resolution,
+// and the motion vectors at half (HALF_MV=1) or full (HALF_MV=0) resolution, in the same pass
+// that fills the shared buffers. One thread per 2x2 block of the full-resolution frame, so it
+// reads exactly what the full-resolution shaders read and writes less.
+//
+//   depth          the nearest of the four samples (FO4 depth: 0 = near, 1 = far), so thin
+//                  foreground objects survive, like FSR3's own nearest-depth dilation.
+//   HALF_MV=1      the motion vector of that same nearest sample.
+//   HALF_MV=0      all four motion vectors, unchanged.
+//   ALPHA_MASK=1   the transparent-surface mask of GenerateSharedBuffersCS (the PostAlpha path);
+//   ALPHA_MASK=0   plain copy (the path without a reticle pass), t0/t1 unused.
+
+#ifndef ALPHA_MASK
+#	define ALPHA_MASK 1
+#endif
+#ifndef HALF_MV
+#	define HALF_MV 0
+#endif
+
+Texture2D<float4> InputTexturePreAlpha : register(t0);
+Texture2D<float4> InputTextureAfterAlpha : register(t1);
+Texture2D<float2> InputMotionVectors : register(t2);
+Texture2D<float> InputDepth : register(t3);
+
+RWTexture2D<float2> OutputMotionVectors : register(u0);
+RWTexture2D<float> OutputDepth : register(u1);
+
+[numthreads(8, 8, 1)] void main(uint3 DTid : SV_DispatchThreadID)
+{
+	uint width, height;
+	InputMotionVectors.GetDimensions(width, height);
+	if (DTid.x * 2 >= width || DTid.y * 2 >= height)
+		return;
+
+	// Out-of-range loads return 0, which is the nearest possible depth; clamp instead.
+	const uint2 last = uint2(width - 1, height - 1);
+
+	float nearestDepth = 2.0;
+	float2 nearestMotion = 0.0;
+
+	[unroll] for (uint i = 0; i < 4; ++i)
+	{
+		const uint2 pos = min(DTid.xy * 2 + uint2(i & 1, i >> 1), last);
+
+		float depth = InputDepth[pos];
+		float2 motion = InputMotionVectors[pos];
+
+#if ALPHA_MASK
+		float3 difference = abs(InputTexturePreAlpha[pos].xyz - InputTextureAfterAlpha[pos].xyz);
+		float mask = max(difference.x, max(difference.y, difference.z));
+		mask *= 1000.0;
+		mask = 1.0 - saturate(mask);
+
+		motion = lerp(0.0, motion, mask);
+		depth = lerp(min(depth, 0.1), depth, mask);
+#endif
+
+#if !HALF_MV
+		OutputMotionVectors[pos] = motion;
+#endif
+
+		if (depth < nearestDepth) {
+			nearestDepth = depth;
+			nearestMotion = motion;
+		}
+	}
+
+	OutputDepth[DTid.xy] = nearestDepth;
+#if HALF_MV
+	OutputMotionVectors[DTid.xy] = nearestMotion;
+#endif
+}
diff --git a/package/F4SE/Plugins/FrameGeneration/SecondaryUpscaleCS.hlsl b/package/F4SE/Plugins/FrameGeneration/SecondaryUpscaleCS.hlsl
new file mode 100644
index 0000000..f51b7b6
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/SecondaryUpscaleCS.hlsl
@@ -0,0 +1,87 @@
+// FG-GPU1: FSR 4.1 upscaling on the second GPU.
+//
+// The render GPU draws the scene at render resolution into the top-left corner of the full-size
+// frame buffer. The UI then needs a full-size background to blend over, and the second GPU needs
+// the UI without that background:
+//
+//   Blit       (render GPU, D3D11) fills the frame buffer from the render-resolution scene, so the
+//              UI is drawn over it at full resolution. It is never shown as it is.
+//   Composite  (display GPU, D3D12) puts the UI on top of the FSR 4.1 result. It rebuilds the same
+//              background from the same scene with the same arithmetic and keeps what the UI changed:
+//                  out = final + (upscaled - background) * (1 - alpha)
+//              with alpha the smallest UI coverage that explains final - background. Where there is
+//              no UI, final == background and out == upscaled; under opaque UI, out == final.
+//
+//   Copy       (display GPU, D3D12) the finished frame unchanged into the composite, for a swap chain
+//              in another format than the game's RGBA8 (an HDR add-on promoted it): copies cannot
+//              convert, a shader store can. Native frames, and every frame without upscaling.
+//
+// Compiled with RENDER_WIDTH, RENDER_HEIGHT, DISPLAY_WIDTH, DISPLAY_HEIGHT defined. All entry
+// points use the same registers; Blit only reads t0, Copy only t1, and both write u0.
+
+static const uint2 RenderSize = uint2(RENDER_WIDTH, RENDER_HEIGHT);
+static const uint2 DisplaySize = uint2(DISPLAY_WIDTH, DISPLAY_HEIGHT);
+
+Texture2D<float4> Scene : register(t0);     // the render-resolution scene (the lane both GPUs have)
+Texture2D<float4> Final : register(t1);     // Composite: the finished frame from the render GPU
+Texture2D<float4> Upscaled : register(t2);  // Composite: the FSR 4.1 output
+RWTexture2D<float4> Output : register(u0);
+
+// Bilinear from render to display resolution with plain loads and precise arithmetic (no fused
+// or reordered operations), so both GPUs get the same background from the same scene. Pixel
+// centres map onto pixel centres.
+float4 SceneBilinear(uint2 a_pixel)
+{
+	precise float2 scale = float2(RenderSize) / float2(DisplaySize);
+	precise float2 position = (float2(a_pixel) + 0.5) * scale - 0.5;
+	position = clamp(position, 0.0, float2(RenderSize - 1));
+
+	uint2 i0 = uint2(position);  // position >= 0, so truncation is floor
+	uint2 i1 = min(i0 + 1, RenderSize - 1);
+	precise float2 f = position - float2(i0);
+
+	float4 c00 = Scene.Load(int3(i0.x, i0.y, 0));
+	float4 c10 = Scene.Load(int3(i1.x, i0.y, 0));
+	float4 c01 = Scene.Load(int3(i0.x, i1.y, 0));
+	float4 c11 = Scene.Load(int3(i1.x, i1.y, 0));
+
+	precise float4 top = c00 + (c10 - c00) * f.x;
+	precise float4 bottom = c01 + (c11 - c01) * f.x;
+	precise float4 result = top + (bottom - top) * f.y;
+	return result;
+}
+
+[numthreads(8, 8, 1)] void Blit(uint3 a_id : SV_DispatchThreadID)
+{
+	if (any(a_id.xy >= DisplaySize))
+		return;
+	Output[a_id.xy] = SceneBilinear(a_id.xy);
+}
+
+[numthreads(8, 8, 1)] void Composite(uint3 a_id : SV_DispatchThreadID)
+{
+	if (any(a_id.xy >= DisplaySize))
+		return;
+
+	// The render GPU stored its background in an 8-bit target before drawing the UI over it.
+	float3 background = round(saturate(SceneBilinear(a_id.xy).rgb) * 255.0) / 255.0;
+	float3 final = Final.Load(int3(a_id.xy, 0)).rgb;
+	float3 upscaled = Upscaled.Load(int3(a_id.xy, 0)).rgb;
+
+	// UI with coverage a and colour c moves a channel by a * (c - background), and |c - background|
+	// is at most max(background, 1 - background): this is the smallest a that explains the change.
+	// Any error is (upscaled - background) * (alpha - a): fine scene detail under translucent UI.
+	float3 change = abs(final - background);
+	float3 room = max(max(background, 1.0 - background), 1.0 / 255.0);
+	float3 coverage = change / room;
+	float alpha = saturate(max(coverage.r, max(coverage.g, coverage.b)));
+
+	Output[a_id.xy] = float4(saturate(final + (upscaled - background) * (1.0 - alpha)), 1.0);
+}
+
+[numthreads(8, 8, 1)] void Copy(uint3 a_id : SV_DispatchThreadID)
+{
+	if (any(a_id.xy >= DisplaySize))
+		return;
+	Output[a_id.xy] = float4(Final.Load(int3(a_id.xy, 0)).rgb, 1.0);
+}
diff --git a/package/F4SE/Plugins/FrameGeneration/UITilesCS.hlsl b/package/F4SE/Plugins/FrameGeneration/UITilesCS.hlsl
new file mode 100644
index 0000000..7e1cb91
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/UITilesCS.hlsl
@@ -0,0 +1,41 @@
+// FG-GPU1 UI tiles, measurement only (plans/UI-TILES.md part 2, step 1).
+//
+// On a frame upscaled on the display GPU, the frame buffer was filled from the stretched scene
+// (Upscaling::FillFrameBufferFromScene) and the UI was drawn over it, so the finished frame differs
+// from that background exactly where something was drawn after PostDisplay. One 32x32 group per
+// tile: counts the 32x32 tiles and the 16x16 quarter tiles with any differing pixel, and the
+// differing pixels themselves.
+//
+// Defines: WIDTH, HEIGHT (the frame's size).
+
+Texture2D<float4> Finished : register(t0);    // the frame as presented (scene stretch + UI)
+Texture2D<float4> Background : register(t1);  // the stretch alone (Upscaling::sceneBlitTarget)
+
+// [0] 32x32 tiles with UI, [1] 16x16 tiles with UI, [2] pixels with UI. Cleared before the dispatch.
+RWByteAddressBuffer Counters : register(u0);
+
+groupshared uint quarters;
+groupshared uint pixels;
+
+[numthreads(32, 32, 1)] void main(uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint gi : SV_GroupIndex)
+{
+	if (gi == 0) {
+		quarters = 0;
+		pixels = 0;
+	}
+	GroupMemoryBarrierWithGroupSync();
+
+	// Both are RGBA8_UNORM read the same way, so equal bytes give equal floats: an exact compare.
+	// Alpha is left out: the display GPU's composite uses only the colour.
+	if (dtid.x < WIDTH && dtid.y < HEIGHT && any(Finished[dtid.xy].rgb != Background[dtid.xy].rgb)) {
+		InterlockedOr(quarters, 1u << ((gtid.y / 16) * 2 + gtid.x / 16));
+		InterlockedAdd(pixels, 1);
+	}
+	GroupMemoryBarrierWithGroupSync();
+
+	if (gi == 0 && quarters != 0) {
+		Counters.InterlockedAdd(0, 1);
+		Counters.InterlockedAdd(4, countbits(quarters));
+		Counters.InterlockedAdd(8, pixels);
+	}
+}
