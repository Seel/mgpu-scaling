+{
+	const std::wstring path = std::wstring(kFfxFolder) + (a_runtime == Runtime::kSDK24 ? kLoaderDll : kLegacyDll);
+	HMODULE handle = LoadLibraryW(path.c_str());
+	if (!handle) {
