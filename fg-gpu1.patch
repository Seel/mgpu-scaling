diff --git a/plugins/MGPUScaling/CMakeLists.txt b/plugins/MGPUScaling/CMakeLists.txt
new file mode 100644
index 0000000..5e2598c
--- /dev/null
+++ b/plugins/MGPUScaling/CMakeLists.txt
@@ -0,0 +1,62 @@
+# MGPU Scaling: AAAMGPUScaling.dll, the frame-generation plugin (plugins/FrameGeneration/src, the
+# FG-GPU1 build of AAAFrameGeneration) and the upscaler (src/upscaler, the FG-GPU1 build of
+# Upscaling, in namespace up) as one F4SE plugin. Both plugins' own XSEPlugin.cpp are replaced by
+# src/XSEPlugin.cpp.
+set(PLUGIN_NAME "MGPUScaling")
+
+add_library(${PLUGIN_NAME} SHARED)
+
+set(FRAMEGEN_DIR "${CMAKE_SOURCE_DIR}/plugins/FrameGeneration/src")
+file(GLOB FRAMEGEN_SOURCES
+	LIST_DIRECTORIES false
+	CONFIGURE_DEPENDS
+	"${FRAMEGEN_DIR}/*.cpp"
+	"${FRAMEGEN_DIR}/*.h"
+)
+list(FILTER FRAMEGEN_SOURCES EXCLUDE REGEX "/XSEPlugin\.cpp$")
+
+file(GLOB_RECURSE PLUGIN_SOURCES
+	LIST_DIRECTORIES false
+	CONFIGURE_DEPENDS
+	"${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp"
+	"${CMAKE_CURRENT_SOURCE_DIR}/src/*.h"
+)
+
+target_sources(${PLUGIN_NAME} PRIVATE ${FRAMEGEN_SOURCES} ${PLUGIN_SOURCES})
+source_group("FrameGeneration" FILES ${FRAMEGEN_SOURCES})
+
+include(Common)
+configure_xse_plugin(${PLUGIN_NAME} 2 0 0)
+
+# "AAA": the frame-generation part's D3D11 device hook must be installed before any other plugin's.
+set_target_properties(${PLUGIN_NAME} PROPERTIES OUTPUT_NAME "AAAMGPUScaling")
+
+# src/ (MGPUScaling.h) comes from configure_xse_plugin. The frame-generation headers are found
+# through this path; the upscaler's resolve next to the files that include them, so the two sets
+# of same-named headers (Upscaling.h, FidelityFX.h, Streamline.h, DX11Hooks.h, Buffer.h) never mix.
+target_include_directories(${PLUGIN_NAME} PRIVATE
+	${FRAMEGEN_DIR}
+	${CMAKE_SOURCE_DIR}/extern/Streamline/external/ngx-sdk/include
+)
+
+# Streamline and XeSS are interface targets that skip themselves when defined already.
+add_subdirectory(${CMAKE_SOURCE_DIR}/cmake/Streamline ${CMAKE_CURRENT_BINARY_DIR}/Streamline)
+add_subdirectory(${CMAKE_SOURCE_DIR}/cmake/XeSS ${CMAKE_CURRENT_BINARY_DIR}/XeSS)
+
+# The union of both plugins' libraries. The FidelityFX SDK 1.x targets (the upscaler's FSR 3.1 on
+# the game's GPU) are defined by plugins/Upscaling, which the top-level CMakeLists adds first.
+target_link_libraries(${PLUGIN_NAME} PRIVATE
+	debug ${CMAKE_SOURCE_DIR}/include/detours/Debug/detours.lib
+	optimized ${CMAKE_SOURCE_DIR}/include/detours/Release/detours.lib
+	Microsoft::DirectXTK
+	Microsoft::DirectXTex
+	Microsoft::DirectX-Headers
+	d3d12.lib
+	magic_enum::magic_enum
+	d3dcompiler.lib
+	Streamline
+	${CMAKE_SOURCE_DIR}/extern/Streamline/external/ngx-sdk/lib/Windows_x86_64/nvsdk_ngx_d.lib
+	XeSS
+	ffx_backend_dx11_x64
+	ffx_fsr3_x64
+)
diff --git a/plugins/MGPUScaling/src/MGPUScaling.cpp b/plugins/MGPUScaling/src/MGPUScaling.cpp
new file mode 100644
index 0000000..a2a39b1
--- /dev/null
+++ b/plugins/MGPUScaling/src/MGPUScaling.cpp
@@ -0,0 +1,98 @@
+#include "MGPUScaling.h"
+
+#include <atomic>
+#include <filesystem>
+#include <iterator>
+#include <string_view>
+#include <system_error>
+
+namespace
+{
+	std::atomic_bool upscalerActive{ false };
+
+	struct LegacyFile
+	{
+		const char* path;
+		const char* section;  // in MGPUScaling.ini
+		const char* const* keys;
+		std::size_t keyCount;
+	};
+
+	// Every key the two old plugins read from their [Settings] section.
+	constexpr const char* kFrameGenerationKeys[] = { "bFrameGenerationMode", "bFrameLimitMode", "bDisableInMenus",
+		"iFrameGenType", "iFrameGenFrames", "iFSRRuntime", "iFSRSwapChainProvider", "iFSRFrameGenProvider",
+		"bEnableDebugLogging", "bFrameGenOnSecondaryGPU", "sSecondaryGPUName", "bSendHudlessFrame", "bTransportHudLess",
+		"bAsyncUnpack", "bEarlyTransfer", "bEarlyUnpack", "iHalfResDepthMV" };
+	constexpr const char* kUpscalingKeys[] = { "iUpscaleMethodPreference", "iQualityMode", "fSharpness", "bEnableDebugLogging" };
+}
+
+void mgpu::LoadSettings(CSimpleIniA& a_ini)
+{
+	a_ini.LoadFile(kDefaultSettings);
+	a_ini.LoadFile(kUserSettings);
+}
+
+bool mgpu::DebugLoggingRequested()
+{
+	CSimpleIniA ini;
+	ini.SetUnicode();
+	LoadSettings(ini);
+	return ini.GetBoolValue(kUpscalingSection, "bEnableDebugLogging", false);
+}
+
+void mgpu::MigrateSettings()
+{
+	std::error_code error;
+	if (std::filesystem::exists(kUserSettings, error))
+		return;
+
+	// The MCM files the FG-GPU1 builds of AAAFrameGeneration.dll and Upscaling.dll used. Upscaling.ini
+	// is shared with doodlum's Upscaling MCM page, so only this plugin's own keys are taken.
+	const LegacyFile legacy[] = {
+		{ "Data\\MCM\\Settings\\FrameGeneration.ini", kFrameGenerationSection, kFrameGenerationKeys, std::size(kFrameGenerationKeys) },
+		{ "Data\\MCM\\Settings\\Upscaling.ini", kUpscalingSection, kUpscalingKeys, std::size(kUpscalingKeys) },
+	};
+
+	CSimpleIniA out;
+	out.SetUnicode();
+	int copied = 0;
+	for (const auto& file : legacy) {
+		CSimpleIniA in;
+		in.SetUnicode();
+		if (in.LoadFile(file.path) < 0)
+			continue;
+		for (std::size_t i = 0; i < file.keyCount; ++i) {
+			const char* value = in.GetValue("Settings", file.keys[i], nullptr);
+			if (!value)
+				continue;
+			// bTransportHudLess is the old name of bSendHudlessFrame.
+			const char* key = std::string_view(file.keys[i]) == "bTransportHudLess" ? "bSendHudlessFrame" : file.keys[i];
+			if (key != file.keys[i] && out.GetValue(file.section, key, nullptr))
+				continue;
+			out.SetValue(file.section, key, value);
+			++copied;
+		}
+	}
+	if (copied == 0)
+		return;
+
+	// No UTF-8 signature: MCM reads this file too.
+	if (out.SaveFile(kUserSettings, false) < 0) {
+		REX::WARN("[INIT] could not write {}; the settings from the old FrameGeneration.ini / Upscaling.ini are not carried over",
+			kUserSettings);
+		return;
+	}
+	REX::INFO("[INIT] carried {} settings over from Data\\MCM\\Settings\\FrameGeneration.ini and Upscaling.ini into {} "
+			  "(the old files are left as they are)",
+		copied, kUserSettings);
+}
+
+bool mgpu::UpscalerActive() noexcept
+{
+	return upscalerActive.load(std::memory_order_relaxed);
+}
+
+void mgpu::SetUpscalerActive(bool a_active) noexcept
+{
+	upscalerActive.store(a_active, std::memory_order_relaxed);
+}
