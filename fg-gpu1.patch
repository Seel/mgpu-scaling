+	ffxLoadFunctions(&functions, handle);
+	if (!functions.CreateContext || !functions.DestroyContext || !functions.Configure || !functions.Query || !functions.Dispatch) {
+		REX::WARN("[FSR] {} does not export the FFX API", Narrow(path.c_str()));
+		FreeLibrary(handle);
+		return false;
