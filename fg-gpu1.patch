new file mode 100644
index 0000000..12b4faa
--- /dev/null
+++ b/plugins/MGPUScaling/src/MGPUScaling.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// MGPU Scaling: one F4SE plugin, AAAMGPUScaling.dll, for what used to be two FG-GPU1 builds of
+// FO4Upscaling's plugins:
+//
+//   frame generation  plugins/FrameGeneration/src (was AAAFrameGeneration.dll): the D3D12 proxy
+//                     swap chain, FSR frame generation, the second-GPU transport and FSR 4.1
+//                     upscaling on the second GPU.
+//   upscaler          src/upscaler, namespace up (was Upscaling.dll): render scale, jitter, TAA,
+//                     mip bias and the dynamic-resolution fixes, plus FSR 3.1/DLSS on the game's GPU.
+//
+// One DLL, one log (MGPUScaling.log), one MCM page and one settings file with a section per part,
+// and its own data folder, so it shares no file with doodlum's Upscaling or FO4Upscaling's
+// AAAFrameGeneration and those mods can simply be disabled. The "AAA" keeps it the first F4SE
+// plugin to load, which the frame-generation part's D3D11 device hook needs (see XSEPlugin.cpp).
+
+#include <SimpleIni.h>
+
+// Everything the package installs under Data\F4SE\Plugins\MGPUScaling. Wide string literals, so
+// MGPU_SHADER(L"X.hlsl") is one literal.
+#define MGPU_PLUGIN_DIR L"Data\\F4SE\\Plugins\\MGPUScaling\\"
+#define MGPU_SHADER(a_file) MGPU_PLUGIN_DIR L"Shaders\\" a_file
+
+namespace mgpu
+{
+	inline constexpr const wchar_t* kFidelityFXDir = MGPU_PLUGIN_DIR L"FidelityFX\\";
+
+	// Shipped defaults, then the user's MCM changes on top.
+	inline constexpr const char* kDefaultSettings = "Data\\MCM\\Config\\MGPUScaling\\settings.ini";
+	inline constexpr const char* kUserSettings = "Data\\MCM\\Settings\\MGPUScaling.ini";
+	inline constexpr const char* kFrameGenerationSection = "FrameGeneration";
+	inline constexpr const char* kUpscalingSection = "Upscaling";
+
+	// Both files into a_ini, defaults first.
+	void LoadSettings(CSimpleIniA& a_ini);
+
+	// Before F4SE::Init (the log level): bEnableDebugLogging in the [Upscaling] section.
+	[[nodiscard]] bool DebugLoggingRequested();
+
+	// Once at load, after the log exists: when the user has no MGPUScaling.ini yet, copies the
+	// settings this plugin knows from the old plugins' MCM files (FrameGeneration.ini and
+	// Upscaling.ini, [Settings]) into it, so MCM and the plugin both show them. The old files are
+	// not touched.
+	void MigrateSettings();
+
+	// The upscaler's hooks are installed. False when another Upscaling.dll is loaded (both would
+	// hook the same render calls), and then the second GPU cannot upscale either.
+	[[nodiscard]] bool UpscalerActive() noexcept;
+	void SetUpscalerActive(bool a_active) noexcept;
+}
diff --git a/plugins/MGPUScaling/src/XSEPlugin.cpp b/plugins/MGPUScaling/src/XSEPlugin.cpp
new file mode 100644
index 0000000..06aac13
--- /dev/null
+++ b/plugins/MGPUScaling/src/XSEPlugin.cpp
@@ -0,0 +1,108 @@
+// MGPU Scaling's F4SE entry point. It does what the two plugins' own entry points did:
+//
+//   F4SEPlugin_Load   the frame-generation part's settings and its D3D11CreateDeviceAndSwapChain
+//                     hook (as AAAFrameGeneration.dll did, first of all plugins)
+//   kPostLoad         the upscaler's D3D11 hook and render hooks (Upscaling.dll installed them in its
+//                     own Load, after the plugins that sort before it, Community Shaders included;
+//                     kPostLoad comes after every plugin's Load, which keeps them outside those)
+//   kPostPostLoad     the frame-generation part's render hooks (as before)
+//   kGameDataReady    the upscaler's menu sink and game settings (as before)
+//
+// Why "AAA": the frame-generation part creates the game's D3D11 device itself and does not call
+// the next hook in the import table, so its hook must be the first one installed (the innermost).
+// F4SE loads plugins in file-name order.
+
+#include "MGPUScaling.h"
+
+#include "DX11Hooks.h"  // frame generation (plugins/FrameGeneration/src)
+#include "Upscaling.h"  // frame generation's state, not the upscaler
+#include "upscaler/Upscaler.h"
+
+// OG F4SE uses F4SEPlugin_Query, NG uses F4SEPlugin_Version. Export both.
+extern "C" DLLEXPORT bool F4SEAPI F4SEPlugin_Query(const F4SE::QueryInterface*, F4SE::PluginInfo* a_info)
+{
+	a_info->infoVersion = F4SE::PluginInfo::kVersion;
+	a_info->name = Plugin::NAME.data();
+	a_info->version = Plugin::VERSION[0];
+	return true;
+}
+
+extern "C" DLLEXPORT constinit auto F4SEPlugin_Version = []() noexcept {
+	F4SE::PluginVersionData data{};
+
+	data.PluginVersion(Plugin::VERSION);
+	data.PluginName(Plugin::NAME.data());
+	data.AuthorName("");
+	data.UsesAddressLibrary(true);
+	data.UsesSigScanning(false);
+	data.IsLayoutDependent(true);
+	data.HasNoStructUse(false);
+	data.CompatibleVersions({ F4SE::RUNTIME_LATEST });
+
+	return data;
+}();
+
+namespace
+{
+	void MessageHandler(F4SE::MessagingInterface::Message* a_message)
+	{
+		switch (a_message->type) {
+		case F4SE::MessagingInterface::kPostLoad:
+			up::OnPostLoad();
+			break;
+		case F4SE::MessagingInterface::kPostPostLoad:
+			Upscaling::GetSingleton()->PostPostLoad();
+			break;
+		case F4SE::MessagingInterface::kGameDataReady:
+			up::OnDataLoaded();
+			break;
+		default:
+			break;
+		}
+	}
+
+	void WarnUser(const wchar_t* a_text)
+	{
+		MessageBoxW(nullptr, a_text, L"MGPU Scaling", MB_OK | MB_ICONWARNING | MB_SETFOREGROUND);
+	}
+}
+
+extern "C" DLLEXPORT bool F4SEAPI F4SEPlugin_Load(const F4SE::LoadInterface* a_f4se)
+{
+	F4SE::InitInfo initInfo{};
+	initInfo.logName = "MGPUScaling";
+	initInfo.logLevel = mgpu::DebugLoggingRequested() ? REX::ELogLevel::Debug : REX::ELogLevel::Info;
+	initInfo.trampoline = true;
+	initInfo.trampolineSize = 1 << 11;  // the two plugins asked for 1 KiB each
+	F4SE::Init(a_f4se, initInfo);
+
+#ifndef NDEBUG
+	while (!REX::W32::IsDebuggerPresent()) {};
+#endif
+
+	// FO4Upscaling's AAAFrameGeneration.dll sorts before this plugin and hooks the same D3D11 call;
+	// its hook would create the device and this one would never run.
+	if (GetModuleHandleW(L"AAAFrameGeneration.dll")) {
+		REX::CRITICAL("[INIT] AAAFrameGeneration.dll (FO4Upscaling's frame generation, or the old FG-GPU1 build) is loaded. "
