+void FidelityFX::CreateSwapChain(IDXGIFactory5* a_dxgiFactory, DXGI_SWAP_CHAIN_DESC1* a_desc, HWND a_window,
+	ID3D12CommandQueue* a_queue, IDXGISwapChain4** a_swapChain)
+{
